{
  "functions": {
    "api/rebuild-parcel-by-lotdp.js": { "maxDuration": 30 },
    "api/repair-v75-4c.js":           { "maxDuration": 60 },
    "api/cleanup-tokens.js":          { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cleanup-tokens",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/tiles/:path*",                              "destination": "/api/tiles" },
    { "source": "/api/applications/evidence/:id/download",        "destination": "/api/evidence-download?id=:id" },
    { "source": "/api/public/lease-offers/:token/:action",        "destination": "/api/public/lease-offers" },
    { "source": "/api/(.*)",                                      "destination": "/api/$1" },
    { "source": "/lease-offer/step-2/:token([A-Za-z0-9]{16,64})", "destination": "/lease-offer/step-2.html" },
    { "source": "/lease-offer/:token([A-Za-z0-9]{16,64})",        "destination": "/lease-offer/index.html" },
    { "source": "/((?!api/|lease-offer/).*)",                     "destination": "/index.html" }
  ]
}
